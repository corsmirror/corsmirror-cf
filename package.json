{
  "name": "corsmirror-cf",
  "version": "1.0.8",
  "description": "CORSmirror Cloudflare",
  "author": "Mark <mark@remarkablemark.org>",
  "scripts": {
    "build": "bash scripts/build.sh",
    "clean": "rm -rf coverage dist",
    "cypress:open": "cypress open",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "lint:tsc": "tsc --noEmit",
    "prepare": "husky",
    "start": "npm run build && wrangler pages dev dist"
  },
  "dependencies": {
    "costatus": "1.0.4"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "28.0.1",
    "@bahmutov/cypress-esbuild-preprocessor": "2.2.8",
    "@cloudflare/workers-types": "5.20261120.1",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "cypress": "16.3.0",
    "cypress-cucumber-steps": "4.0.0",
    "eslint": "10.15.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-tsdoc": "0.5.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.2",
    "marked": "18.2.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "wrangler": "4.165.0"
  },
  "private": true,
  "license": "MIT"
}
